# ============================================================================
#  Locator Beast — environment template
#  Copy to .env.local and fill in real values. .env.local is gitignored;
#  NEVER commit real secrets. See docs/environments.md for the full rundown.
# ============================================================================

# ── Supabase project (READ THIS) ────────────────────────────────────────────
# This repo can point at ONE OF TWO SEPARATE Supabase projects. Choose the
# right one on purpose — connecting to the wrong DB makes features look broken.
#
#   • Locator Beast (SaaS)   ref onwrrajmklxtnabekzcy   ← DEFAULT for LB dev
#       The CRM, onboarding, service areas, and companion schema live here.
#       The Supabase CLI is linked to this project; migrations apply here.
#
#   • Lone Star Locators     ref ukkxisleiprdpptaaxcs   ← FROZEN, legacy only
#       Only the legacy marketing/SEO routes (app/(site)/*) read from it.
#       DO NOT run migrations against it. If you point local dev here, the LB
#       SaaS features WILL look broken (missing tables/RPCs) — that's expected,
#       and the dev server will print a ⚠️ warning (see lib/supabase/projects.ts).
#
# Default = Locator Beast. Use its anon + service-role keys from the Supabase
# dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://onwrrajmklxtnabekzcy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-locator-beast-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-locator-beast-service-role-key

# ── AI (Anthropic) ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Two INDEPENDENT Resend accounts — never share a key between them.
#   RESEND_API_KEY          → Locator Beast account (sends from locatorbeast.com)
#   LONESTAR_RESEND_API_KEY → Lone Star account     (sends from lonestarlocators.app)
RESEND_API_KEY=
LONESTAR_RESEND_API_KEY=

# ── Payments (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── Google (per-user Calendar/Contacts OAuth + legacy global integration) ────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# ── Telephony (Twilio) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# ── Voice (Vapi) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# ── Analytics (Meta Pixel) ──────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
