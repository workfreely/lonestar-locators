# ===============================
# System files
# ===============================
.DS_Store
Thumbs.db

# ===============================
# Node / Next.js
# ===============================
node_modules/
.next/
out/
dist/

# ===============================
# Environment variables
# ===============================
.env
.env.local
.env.*.local
# `.env` matches ONLY that exact filename and `.env.*.local` does not match
# `.env.production`, so the framework's own production env file was stageable.
# Named explicitly rather than globbing `.env*`, which would also swallow the
# intentionally tracked `.env.example`.
.env.production

# ===============================
# Logs
# ===============================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===============================
# IDE / Editor
# ===============================
.vscode/
.idea/

# ===============================
# Build artifacts
# ===============================
*.tsbuildinfo

# ===============================
# OS / temp
# ===============================
*.swp
*.swo

.vercel

# Local Supabase env backups (may contain secrets) — never commit
.env.local.*
.env.*.bak

# Local session recovery snapshots (never deploy/commit)
.snapshots/
# HeyGen test artifacts — local only, never committed
heygen-avatars.html
heygen-avatars.json

# Local preview scratch (large media, never committed)
public/_scratch/
