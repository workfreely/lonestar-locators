{
  "manifest_version": 3,
  "name": "Locator Beast Companion",
  "version": "0.1.0",
  "description": "Brings Locator Beast into supported websites through a contextual companion side panel.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Locator Beast Companion"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.smartapartmentdata.com/*",
        "https://smartapartmentdata.com/*",
        "https://*.smartapartmentdata.com/*",
        "https://locatorbeast.com/admin/*",
        "https://www.locatorbeast.com/admin/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.smartapartmentdata.com/*",
        "https://smartapartmentdata.com/*",
        "https://*.smartapartmentdata.com/*"
      ],
      "js": ["sadNavMain.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": ["sidePanel", "storage"]
}
