// app/[city]/blog/[slug]/page.tsx

/**
 * ⚠️ DISABLED ROUTE
 *
 * This file was intentionally disabled during the Supabase blog migration.
 * Reason:
 * - Conflicted with Next.js 15 App Router param typing
 * - Duplicate / legacy blog route outside `(site)` group
 *
 * Planned replacement:
 * app/(site)/[city]/blog/[slug]/page.tsx
 *
 * Do NOT re-enable without reviewing routing + params strategy.
 */


import { notFound } from "next/navigation";
import { supabase } from "@/app/lib/supabaseClient";
import BlogLayout from "@/app/components/BlogLayout";

interface PageProps {
  params: {
    city: string;
    slug: string;
  };
}

export default function BlogPage({ params }: PageProps) {
  const { city, slug } = params;

  return (async () => {
    const { data: blog, error } = await supabase
      .from("blogs")
      .select("*")
      .eq("city_slug", city)
      .eq("slug", slug)
      .eq("status", "published")
      .single();

    if (error || !blog) {
      return notFound();
    }

    const keywords: string[] = Array.isArray(blog.keywords)
      ? blog.keywords
      : typeof blog.keywords === "string"
      ? blog.keywords.split(",").map((k) => k.trim())
      : [];

    return (
      <BlogLayout
        title={blog.title}
        publishDate={blog.publish_date || undefined}
        keywords={keywords}
        content={
          <div
            dangerouslySetInnerHTML={{
              __html: blog.body_html || blog.body_markdown,
            }}
          />
        }
        faqs={blog.faqs || []}
      />
    );
  })();
}
